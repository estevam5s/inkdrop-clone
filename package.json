{
  "name": "inkdrop-clone",
  "version": "1.0.0",
  "description": "Complete Inkdrop clone — Markdown note-taking app reverse-engineered from Inkdrop v6.1.5 via REA",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "uuid": "^9.0.0",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.clone.inkdrop",
    "productName": "Inkdrop Clone",
    "mac": { "category": "public.app-category.productivity" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" },
    "files": ["src/**/*", "static/**/*", "package.json"]
  }
}
